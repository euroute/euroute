# Euroute — example environment file.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# Placeholders only — no real keys belong in this file.

# Backend project reference (public by design)
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
# Publishable/anon key — safe to expose to browsers
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Client-visible copies of the same public values (Vite inlines these)
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Server-only secrets — must never be prefixed with VITE_ and never committed.
# Service-role key for privileged server code (bypasses row-level security).
SUPABASE_SERVICE_ROLE_KEY="replace_me_server_only"
# Salt for hashing rate-limit client keys. Generate a fresh random value, e.g.
#   openssl rand -hex 32
EUROUTE_RATE_LIMIT_SALT="replace_me_random_32_byte_hex"
